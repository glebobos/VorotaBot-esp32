FROM node:20-alpine

WORKDIR /app

# Cache package dependencies
COPY package.json package-lock.json* ./
RUN npm install

# Copy application source
COPY . .

# Build frontend and gzip static web assets for SPIFFS embedding
CMD ["sh", "-c", "npm run build && find dist -type f \\( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.json' \\) -exec gzip -f -k -9 {} \\;"]
